{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jade.local/schemas/_defs.schema.json",
  "$defs": {
    "schema_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "ts": { "type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "id": { "type": "string", "pattern": "^(dec|q|prm|out|wi|imp|call|exec|task)_[0-9a-f]{12}$" },
    "ref": { "type": "string", "minLength": 1, "maxLength": 512 },
    "risk_level": { "enum": ["low", "medium", "high", "critical"] },
    "environment": { "enum": ["local", "staging", "production"] },
    "route": { "enum": ["FAST", "JEV", "DEEP", "ESCALATE"] },
    "primitive": { "enum": ["noul", "choice", "score"] }
  }
}
