{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jade.local/schemas/decision.schema.json",
  "title": "Decision",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "decision_id", "task_id", "tenant_scope", "objective", "candidate_actions", "constraints", "assumptions", "evidence_refs", "context_fingerprint", "context_freshness", "risk", "route", "evaluation_refs", "policy_version", "status", "timestamps", "trace_id", "session_id", "revision_count"],
  "properties": {
    "schema_version": { "$ref": "_defs.schema.json#/$defs/schema_version" },
    "decision_id": { "$ref": "_defs.schema.json#/$defs/id" },
    "task_id": { "$ref": "_defs.schema.json#/$defs/id" },
    "tenant_scope": { "type": "string", "pattern": "^local:[a-z0-9._-]+$" },
    "objective": { "type": "string", "minLength": 8, "maxLength": 2000 },
    "candidate_actions": {
      "type": "array", "minItems": 1, "maxItems": 32,
      "items": { "type": "object", "additionalProperties": false, "required": ["name", "canonical_action", "description"],
        "properties": { "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$" }, "canonical_action": { "type": "string" }, "description": { "type": "string" }, "eligible": { "type": "boolean" } } }
    },
    "constraints": { "type": "array", "items": { "type": "string" } },
    "assumptions": { "type": "array", "items": { "type": "string" } },
    "evidence_refs": { "type": "array", "items": { "$ref": "_defs.schema.json#/$defs/ref" } },
    "context_fingerprint": { "$ref": "_defs.schema.json#/$defs/sha256" },
    "context_freshness": { "type": "object", "additionalProperties": false, "required": ["observed_at", "ttl_s"],
      "properties": { "observed_at": { "$ref": "_defs.schema.json#/$defs/ts" }, "ttl_s": { "type": "integer", "minimum": 1 } } },
    "risk": { "type": "object", "additionalProperties": false,
      "required": ["level", "reversibility", "environment", "blast_radius", "data_sensitivity", "permission_scope", "rationale", "rule_id"],
      "properties": {
        "level": { "$ref": "_defs.schema.json#/$defs/risk_level" },
        "reversibility": { "enum": ["reversible", "partially_reversible", "irreversible"] },
        "environment": { "$ref": "_defs.schema.json#/$defs/environment" },
        "blast_radius": { "enum": ["file", "repo", "host", "service", "org", "public"] },
        "data_sensitivity": { "enum": ["none", "internal", "personal", "secret"] },
        "permission_scope": { "type": "string" },
        "rationale": { "type": "string", "minLength": 1 },
        "rule_id": { "type": "string", "pattern": "^(R-(L?[0-9]{2}|ENV)|M-[0-9]{2})$" }
      } },
    "route": { "$ref": "_defs.schema.json#/$defs/route" },
    "evaluation_refs": { "type": "array", "items": { "$ref": "_defs.schema.json#/$defs/ref" } },
    "policy_version": { "type": "string", "pattern": "^[0-9a-f]{7,40}$" },
    "status": { "enum": ["RECEIVED", "VALIDATED", "CLASSIFIED", "EVALUATING", "NEEDS_EVIDENCE", "NEEDS_REVISION", "ABSTAINED", "REJECTED", "ACCEPTED", "AUTHORIZED", "EXECUTING", "VERIFYING", "SUCCEEDED", "FAILED", "COMPENSATED", "ROLLED_BACK", "OUTCOME_UNKNOWN", "WAITING_HUMAN", "WAITING_DEPENDENCY", "RETRY_SCHEDULED", "CANCELLED", "EXPIRED"] },
    "timestamps": { "type": "object", "additionalProperties": false, "required": ["created_at", "updated_at", "expires_at"],
      "properties": { "created_at": { "$ref": "_defs.schema.json#/$defs/ts" }, "updated_at": { "$ref": "_defs.schema.json#/$defs/ts" }, "expires_at": { "$ref": "_defs.schema.json#/$defs/ts" } } },
    "trace_id": { "type": "string", "minLength": 8 },
    "session_id": { "type": "string", "minLength": 8 },
    "revision_count": { "type": "integer", "minimum": 0, "maximum": 3 },
    "permit_id": { "$ref": "_defs.schema.json#/$defs/id" },
    "human_only": { "type": "boolean" },
    "ho_ids": { "type": "array", "items": { "type": "string", "pattern": "^HO-[a-z0-9-]+$" }, "maxItems": 16 },
    "ask": { "type": "object", "additionalProperties": false, "required": ["channel", "ask_id", "answer", "answered_at"],
      "properties": { "channel": { "enum": ["chat", "dialog", "memory"] }, "ask_id": { "type": "string", "pattern": "^[0-9a-f]{12}$" },
                      "answer": { "enum": ["allow", "deny"] }, "answered_at": { "$ref": "_defs.schema.json#/$defs/ts" } } }
  }
}
