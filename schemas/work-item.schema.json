{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jade.local/schemas/work-item.schema.json",
  "title": "WorkItem",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "parent", "type", "priority", "status", "owner", "dependencies", "impact", "rationale", "evidence_refs", "next_action", "retry_or_revisit_trigger", "created_at", "updated_at", "history"],
  "properties": {
    "schema_version": { "$ref": "_defs.schema.json#/$defs/schema_version" },
    "id": { "type": "string", "pattern": "^W-[0-9]{2,4}$" },
    "parent": { "type": ["string", "null"], "pattern": "^W-[0-9]{2,4}$" },
    "type": { "enum": ["blocker", "ambiguity", "risk", "debt", "followup"] },
    "priority": { "enum": ["P0", "P1", "P2", "P3"] },
    "status": { "enum": ["open", "in_progress", "waiting_human", "blocked", "done", "dropped"] },
    "owner": { "enum": ["human", "agent", "runtime"] },
    "dependencies": { "type": "array", "items": { "type": "string", "pattern": "^W-[0-9]{2,4}$" } },
    "impact": { "type": "string", "minLength": 1 },
    "rationale": { "type": "string", "minLength": 1 },
    "evidence_refs": { "type": "array", "items": { "type": "string" } },
    "next_action": { "type": "string", "minLength": 1 },
    "retry_or_revisit_trigger": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}" },
    "updated_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}" },
    "history": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["at", "change"], "properties": { "at": { "type": "string" }, "change": { "type": "string" } } } },
    "title": { "type": "string" },
    "phase": { "type": "integer", "minimum": 0, "maximum": 5 }
  }
}
