{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jade.local/schemas/permit.schema.json",
  "title": "ExecutionPermit",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "permit_id", "decision_id", "principal", "authorized_action", "resource_scope", "environment", "plan_hash", "preconditions", "policy_version", "issued_at", "expires_at", "nonce", "usage_limit", "uses", "state", "risk_level"],
  "properties": {
    "schema_version": { "$ref": "_defs.schema.json#/$defs/schema_version" },
    "permit_id": { "$ref": "_defs.schema.json#/$defs/id" },
    "decision_id": { "$ref": "_defs.schema.json#/$defs/id" },
    "principal": { "type": "string", "pattern": "^(agent|human):[a-z0-9._-]+$" },
    "authorized_action": { "type": "string", "pattern": "^[a-z]+(\\.[a-z_]+)*$" },
    "resource_scope": { "type": "string", "minLength": 1 },
    "environment": { "$ref": "_defs.schema.json#/$defs/environment" },
    "plan_hash": { "$ref": "_defs.schema.json#/$defs/sha256" },
    "preconditions": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["kind", "fingerprint"],
      "properties": { "kind": { "enum": ["git_head", "file_sha", "service_state", "policy_version", "custom"] }, "fingerprint": { "type": "string" } } } },
    "policy_version": { "type": "string", "pattern": "^[0-9a-f]{7,40}$" },
    "approval_reference": { "type": "string", "pattern": "^(tty|sig):[a-z0-9._-]+@[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9:.]+Z$" },
    "approval_signature": { "type": "string", "pattern": "^-----BEGIN SSH SIGNATURE-----", "maxLength": 4096 },
    "approval_valid_until": { "$ref": "_defs.schema.json#/$defs/ts" },
    "issued_at": { "$ref": "_defs.schema.json#/$defs/ts" },
    "expires_at": { "$ref": "_defs.schema.json#/$defs/ts" },
    "nonce": { "type": "string", "pattern": "^[0-9a-f]{32}$" },
    "usage_limit": { "const": 1 },
    "uses": { "type": "integer", "minimum": 0, "maximum": 1 },
    "state": { "enum": ["PENDING", "ISSUED", "CONSUMED", "REVOKED", "EXPIRED"] },
    "risk_level": { "$ref": "_defs.schema.json#/$defs/risk_level" },
    "seal": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  },
  "allOf": [
    { "if": { "properties": { "risk_level": { "enum": ["high", "critical"] }, "state": { "enum": ["ISSUED", "CONSUMED"] } }, "required": ["risk_level", "state"] },
      "then": { "required": ["approval_reference"] } }
  ]
}
