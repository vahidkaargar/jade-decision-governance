{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jade.local/schemas/question.schema.json",
  "title": "JevQuestion",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "question_id", "version", "primitive", "task_family", "objective", "input_schema", "output_schema", "required_evidence", "template", "prompt_or_template_version", "model_version", "calibration_group", "threshold_policy", "abstention_behavior", "fallback", "dependencies", "batch_eligibility"],
  "properties": {
    "schema_version": { "$ref": "_defs.schema.json#/$defs/schema_version" },
    "question_id": { "type": "string", "pattern": "^q\\.[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$" },
    "version": { "type": "integer", "minimum": 1 },
    "primitive": { "$ref": "_defs.schema.json#/$defs/primitive" },
    "task_family": { "enum": ["verify_claim", "root_cause", "strategy_choice", "risk_triage", "evidence_quality", "candidate_fit", "routing"] },
    "objective": { "type": "string", "minLength": 8 },
    "input_schema": { "type": "object" },
    "output_schema": { "type": "object" },
    "required_evidence": { "type": "array", "items": { "type": "string" } },
    "template": { "type": "object", "additionalProperties": false, "required": ["instructions"],
      "properties": { "instructions": { "type": "string", "minLength": 8 },
        "criteria": { "oneOf": [ { "type": "object", "additionalProperties": { "type": "string" }, "minProperties": 2, "maxProperties": 255 }, { "type": "array", "items": { "type": "string" }, "minItems": 2, "maxItems": 10 } ] } } },
    "prompt_or_template_version": { "type": "string" },
    "model_version": { "type": "object", "additionalProperties": false, "required": ["request_id", "accepted_resolved"],
      "properties": { "request_id": { "type": "string" }, "accepted_resolved": { "type": "array", "minItems": 1, "items": { "type": "string" } } } },
    "calibration_group": { "type": "string" },
    "threshold_policy": { "type": "object", "additionalProperties": false, "required": ["metric", "accept", "reject"],
      "properties": { "metric": { "enum": ["noul_p", "choice_top_p", "score_mean"] }, "accept": { "type": "number", "minimum": 0, "maximum": 1 }, "reject": { "type": "number", "minimum": 0, "maximum": 1 } } },
    "abstention_behavior": { "enum": ["return_abstain", "escalate_deep", "escalate_human"] },
    "fallback": { "enum": ["deep", "human", "fast"] },
    "dependencies": { "type": "array", "items": { "type": "string" } },
    "batch_eligibility": { "type": "boolean" },
    "no_match_option": { "type": ["string", "null"] },
    "min_options": { "type": "integer", "minimum": 2 }
  }
}
