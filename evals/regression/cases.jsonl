{"id": "R01", "class": "low_p_then_done", "kind": "verify", "p": 0.55, "risk": "low", "expect_exit": 3, "note": "baseline: 30% of low-P answers were followed by a done claim"}
{"id": "R02", "class": "paraphrase_evidence", "kind": "verify", "p": 0.08, "risk": "low", "expect_exit": 4}
{"id": "R03", "class": "accept_band", "kind": "verify", "p": 0.95, "risk": "low", "expect_exit": 0}
{"id": "R04", "class": "high_risk_stricter_band", "kind": "verify", "p": 0.8, "risk": "high", "expect_exit": 3, "note": "0.80 accepts at low risk, abstains at high"}
{"id": "R05", "class": "critical_risk_stricter_band", "kind": "verify", "p": 0.89, "risk": "critical", "expect_exit": 3}
{"id": "R06", "class": "repeat_without_new_evidence", "kind": "repeat", "p": 0.9, "expect_provider_calls": 1, "note": "baseline: 20% of calls were repeats"}
{"id": "R07", "class": "degenerate_choice", "kind": "choice", "options": ["only=one"], "expect_exit": 6}
{"id": "R08", "class": "provider_unavailable", "kind": "provider_error", "error_kind": "UNAVAILABLE", "expect_exit": 5}
