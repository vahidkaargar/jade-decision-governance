{
  "schema_version": "1.0.0",
  "question_id": "q.evidence.quality",
  "version": 1,
  "primitive": "score",
  "task_family": "evidence_quality",
  "objective": "Rank how complete and raw the evidence for a claim is",
  "input_schema": {
    "type": "object",
    "required": [
      "evidence"
    ],
    "properties": {
      "claim": {
        "type": "string"
      },
      "evidence": {
        "type": "string"
      },
      "evidence_source": {
        "type": "string"
      }
    }
  },
  "output_schema": {
    "type": "object",
    "required": [
      "score"
    ],
    "properties": {
      "score": {
        "type": "number"
      }
    }
  },
  "required_evidence": [
    "raw tool output, diff or document excerpt; not a paraphrase"
  ],
  "template": {
    "instructions": "How complete and raw is `evidence` as support for `claim`?",
    "criteria": [
      "none",
      "summary only",
      "partial raw",
      "complete raw with source"
    ]
  },
  "prompt_or_template_version": "2026-11-09.1",
  "model_version": {
    "request_id": "typesafe/jev-1.14",
    "accepted_resolved": [
      "typesafe/jev-1.14-20261014"
    ]
  },
  "calibration_group": "evidence_quality/v1/jev-1.14-20261014",
  "threshold_policy": {
    "metric": "score_mean",
    "accept": 0.0,
    "reject": 0.0
  },
  "abstention_behavior": "return_abstain",
  "fallback": "fast",
  "dependencies": [],
  "batch_eligibility": true,
  "no_match_option": null
}
