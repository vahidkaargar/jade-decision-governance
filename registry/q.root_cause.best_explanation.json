  "calibration_group": "root_cause/v1/jev-1.14-20261014",
  "threshold_policy": {
    "metric": "choice_top_p",
    "accept": 0.6,
    "reject": 0.0
  },
  "abstention_behavior": "return_abstain",
  "fallback": "deep",
  "dependencies": [
    "q.root_cause.any_fits"
  ],
  "batch_eligibility": false,
  "no_match_option": "none_of_these",
